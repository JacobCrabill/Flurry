// A doubly-periodic Cartesian box on a generated mesh, so it runs with no
// external mesh file.
//
// The only initial condition implemented so far is a uniform freestream, which
// on a periodic domain is an exact steady solution -- so this case is really an
// end-to-end free-stream preservation check: every reported residual should sit
// at roundoff for the whole run. Anything that grows means the operators, the
// metric terms or the periodic pairing are wrong.
//
// Only `core`, `equation`, `time` and `output` are required; every other
// section is left out here and takes its defaults.
.{
  .core = .{
      .n_dims = 2,
      .mesh_file = "",
      .order = 3,
  },

  .equation = .{
      .equation = .euler_ns,
      .viscous = false,
  },

  .time = .{
      .dt_scheme = .rk44,
      .n_steps = 500,
      .dt = 1e-3,
  },

  .output = .{
      .output_prefix = "quadbox",
      .write_freq = 0,
      .report_freq = 50,
  },

  .freestream = .{
      .mach_fs = 0.2,
      .norm_fs = [1.0, 0.0, 0.0],
      .fix_vis = true,
  },

  // Boundaries on a generated mesh are named here rather than through
  // `boundary_conditions.mesh_bounds`, which maps the names in a Gmsh file.
  .create_mesh = .{
      .nx = 20,
      .ny = 20,
      .xmin = -5.0,
      .xmax = 5.0,
      .ymin = -5.0,
      .ymax = 5.0,
      .bc_bottom = .periodic,
      .bc_top = .periodic,
      .bc_left = .periodic,
      .bc_right = .periodic,
  },
}
